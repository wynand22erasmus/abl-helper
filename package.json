{
  "name": "abl-helper",
  "displayName": "ABL Helper",
  "description": "OpenEdge ABL syntax highlighting, outline, autocomplete, snippets, formatting, and syntax checking for VS Code.",
  "version": "0.2.0",
  "publisher": "abl-helper",
  "repository": {
    "type": "git",
    "url": "https://github.com/wynand22erasmus/abl-helper.git"
  },
  "homepage": "https://github.com/wynand22erasmus/abl-helper#readme",
  "bugs": {
    "url": "https://github.com/wynand22erasmus/abl-helper/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:abl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "abl",
        "aliases": [
          "OpenEdge ABL",
          "ABL",
          "Progress"
        ],
        "extensions": [
          ".p",
          ".cls",
          ".w",
          ".i"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "abl",
        "path": "./snippets/abl.code-snippets"
      }
    ],
    "grammars": [
      {
        "language": "abl",
        "scopeName": "source.abl",
        "path": "./syntaxes/abl.tmLanguage.json"
      },
      {
        "scopeName": "abl-helper.research.injection",
        "path": "./syntaxes/research-injection.tmLanguage.json",
        "injectTo": [
          "source.abl"
        ]
      }
    ],
    "commands": [
      {
        "command": "ablHelper.checkSyntax",
        "title": "ABL Helper: Check Syntax"
      },
      {
        "command": "ablHelper.formatKeywordsUpper",
        "title": "ABL Helper: Format Keywords (Upper Case)"
      },
      {
        "command": "ablHelper.formatKeywordsLower",
        "title": "ABL Helper: Format Keywords (Lower Case)"
      },
      {
        "command": "ablHelper.formatTrimRight",
        "title": "ABL Helper: Trim Trailing Whitespace"
      },
      {
        "command": "ablHelper.showOutput",
        "title": "ABL Helper: Show Output"
      },
      {
        "command": "ablHelper.restartParser",
        "title": "ABL Helper: Reload Tree-sitter Parser"
      }
    ],
    "configuration": {
      "title": "ABL Helper",
      "properties": {
        "ablHelper.dlcPath": {
          "type": "string",
          "default": "",
          "description": "Path to OpenEdge installation (DLC). If empty, the DLC environment variable is used."
        },
        "ablHelper.propath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "PROPATH entries (in order). Workspace folder is appended when empty."
        },
        "ablHelper.parameterFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Parameter files (-pf) passed to the OpenEdge session."
        },
        "ablHelper.workingDirectory": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "Working directory for OpenEdge subprocesses."
        },
        "ablHelper.checkSyntaxExtraArgs": {
          "type": "string",
          "default": "",
          "description": "Extra arguments appended to the check-syntax invocation (advanced; single- and double-quoted values are supported)."
        },
        "ablHelper.checkSyntax.verboseListing": {
          "type": "boolean",
          "default": false,
          "description": "Log the full check-syntax listing in the output channel. When false, listing output is truncated to 8 KB."
        },
        "ablHelper.batchExecutable": {
          "type": "string",
          "default": "_progres",
          "description": "Batch OpenEdge executable name (typically _progres on Windows/Unix)."
        },
        "ablHelper.format.keywordCaseOnFormatDocument": {
          "type": "string",
          "enum": [
            "none",
            "upper",
            "lower"
          ],
          "default": "none",
          "description": "When using Format Document, adjust ABL keyword casing (Tier A)."
        },
        "ablHelper.format.trimTrailingWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Trim trailing whitespace on Format Document (Tier A)."
        },
        "ablHelper.format.enableTreeSitterPass": {
          "type": "boolean",
          "default": false,
          "description": "Experimental: run minimal tree-sitter-based formatting (Tier B). Off by default."
        },
        "ablHelper.outline.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "description": "Debounce in milliseconds before re-parsing for outline updates."
        },
        "ablHelper.corpus.adeRoot": {
          "type": "string",
          "default": "",
          "description": "Used by corpus smoke tests: path to checked-out progress/ADE. If empty, tests use ADE_ROOT env or corpus/ade."
        },
        "ablHelper.corpus.maxFileBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 4096,
          "description": "Used by corpus smoke tests: skip ADE files larger than this many bytes."
        },
        "ablHelper.corpus.sampleSize": {
          "type": "number",
          "default": 400,
          "minimum": 1,
          "description": "Used by corpus smoke tests: deterministic sample size for ADE parse smoke runs."
        }
      }
    },
    "configurationDefaults": {
      "[abl]": {
        "editor.formatOnSave": false
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run grammar:build && npm run compile && npm run build:parser",
    "compile": "npm run compile:grammar && npm run compile:extension && npm run compile:src && npm run compile:scripts && npm run compile:parser-runtime",
    "compile:extension": "tsx esbuild.config.ts",
    "compile:grammar": "tsx scripts/build-parser-grammar.ts",
    "check:scanner": "tsx parser/abl/src/scanner.manifest.ts",
    "compile:src": "tsc -p tsconfig.build.json",
    "compile:scripts": "tsc -p tsconfig.scripts.build.json",
    "compile:parser-runtime": "tsc -p tsconfig.parser-runtime.json",
    "watch": "tsx esbuild.config.ts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.grammar.json --noEmit",
    "lint": "eslint . && npm run check:typescript-only",
    "check:typescript-only": "tsx scripts/check-typescript-only.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:corpus": "vitest run src/test/corpus.test.ts",
    "build:parser": "tsx scripts/verify-parser-artifacts.ts && tsx scripts/build-parser-assets.ts",
    "sync:parser-sources": "tsx scripts/sync-parser-sources.ts",
    "corpus:sync": "tsx scripts/sync-ade-corpus.ts",
    "grammar:build": "tsx scripts/build-syntax-from-research.ts",
    "grammar:abl:build": "npm run compile:grammar",
    "audit:languages": "tsx scripts/audit-languages.ts",
    "package": "npm run build && vsce package --no-dependencies --out abl-helper-dev.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
