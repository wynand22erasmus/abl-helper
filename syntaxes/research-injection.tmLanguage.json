{
  "scopeName": "abl-helper.research.injection",
  "injectionSelector": "L:source.abl -comment -string",
  "patterns": [
    {
      "include": "#research-root"
    }
  ],
  "repository": {
    "research-root": {
      "patterns": [
        {
          "include": "#preprocessor-line-128"
        },
        {
          "include": "#preprocessor-builtin-128"
        },
        {
          "include": "#dotnet-inner-type-plus"
        },
        {
          "include": "#reserved-keywords-128"
        },
        {
          "include": "#statement-keywords-128"
        },
        {
          "include": "#operators-keyword-index"
        }
      ]
    },
    "preprocessor-line-128": {
      "patterns": [
        {
          "begin": "(?i)^\\s*((&)(webstream))\\b",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.preprocessor.abl"
            },
            "3": {
              "name": "keyword.control.directive.preprocessor.abl"
            }
          },
          "end": "$",
          "name": "meta.preprocessor.line.abl"
        }
      ]
    },
    "preprocessor-builtin-128": {
      "patterns": [
        {
          "match": "(?i)(\\{)(&)(BATCH\\-MODE|FILE\\-NAME|LINE\\-NUMBER|OPSYS|PROCESS\\-ARCHITECTURE|SEQUENCE|WINDOW\\-SYSTEM|DISPLAY|OUT|OUT\\-FMT|OUT\\-LONG|WEBSTREAM)(\\s*\\})",
          "captures": {
            "1": {
              "name": "punctuation.section.abl"
            },
            "2": {
              "name": "punctuation.definition.preprocessor.abl"
            },
            "3": {
              "name": "variable.preprocessor.builtin.abl"
            },
            "4": {
              "name": "punctuation.section.abl"
            }
          },
          "comment": "Built-in {&...} from OpenEdge 12.8 Keyword Index + SpeedScript (research doc)."
        }
      ]
    },
    "dotnet-inner-type-plus": {
      "match": "(?i)(?<=[\\w#$%])(\\+)(?=[\\w#$%])",
      "captures": {
        "1": {
          "name": "punctuation.separator.type.abl"
        }
      },
      "comment": ".NET inner type separator in type names (Type-name syntax 12.8)."
    },
    "reserved-keywords-128": {
      "name": "keyword.control.reserved.abl",
      "match": "(?i)(?<=^|[\\s(,])(?:ACCU(?:MULATE)?|ACC(?:UM)?|AMBI(?:GUOUS)?|AMB(?:IG)?|AND|AS|ASS(?:IGN)?|AT|BEG(?:INS)?|BET(?:WEEN)?|CAN(?:\\-DO)?|CAN\\-(?:FIND)?|CONT(?:AINS)?|DEF|DEF(?:INE)?|DEL(?:ETE)?|DESC|DESC(?:ENDING)?|EQ|GE|GT|IN|LE|LT|MOD|NE|NOT|OR|TO|UNL(?:ESS)?|WHEN|WHE(?:RE)?|WHI(?:LE)?|WITH)(?![a-zA-Z0-9_\\-#$%])",
      "comment": "Reserved keywords (OpenEdge 12.8 Keyword Index Rsrv). Generated by scripts/build-syntax-from-research.ts"
    },
    "statement-keywords-128": {
      "name": "keyword.control.statement.abl",
      "match": "(?i)(?<=^|[\\s(,])(?:ASSEMBLY|BLOCK\\-LEVEL|BUFFER\\-COPY|CAST|CLOSE|CLOSE\\-QUERY|CONNECT|CONSTRUCTOR|DATASET|DESTRUCTOR|DISCONNECT|DYNAMIC\\-NEW|EXPORT|IMPORT|INTERFACE|LEAVE|NEXT|OPEN\\-QUERY|QUIT|RETURN|STOP|SUPER|THIS\\-OBJECT|THROW|UNDO|USING|WEBSTREAM)(?![a-zA-Z0-9_\\-#$%])",
      "comment": "Statement keywords from docs/research-openedge-abl-reference-128.md. Generated script."
    },
    "operators-keyword-index": {
      "patterns": [
        {
          "match": "(<=|<>|>=)",
          "captures": {
            "1": {
              "name": "keyword.operator.abl"
            }
          },
          "comment": "Operators indexed in OpenEdge 12.8 Keyword Index."
        },
        {
          "match": "(?i)(?<=\\s)(@)(?=\\s|\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.abl"
            }
          }
        }
      ]
    }
  }
}
